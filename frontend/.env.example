# Browser API prefix. Vite inlines this at build time.
#
# Local development (default if unset): same-origin /api, proxied by Vite
# to http://localhost:3000 — leave this commented or set to /api.
# VITE_API_URL=/api
#
# Vercel production / preview build (required):
VITE_API_URL=https://codeyoung-trail-booking.onrender.com/api
