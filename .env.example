# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Replace all placeholders before running locally.
DATABASE_URL="postgresql://user:password@localhost:5432/codeyoung?schema=public"

# ── Application ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Booking configuration ─────────────────────────────────────────────────────
# Minimum lead time (in hours) required before a class can be booked.
# Must be a positive integer. Default: 1
BOOKING_LEAD_TIME_HOURS=1

# Maximum number of confirmed bookings a mentor may have on a single mentor-local day.
# Default: 2 (per PRD)
MENTOR_DAILY_CAP=2

# Number of alternate slots returned when the requested slot is unavailable.
# Default: 3
ALTERNATE_SLOTS_COUNT=3

# ── Idempotency ───────────────────────────────────────────────────────────────
# How long (in hours) idempotency key records are considered active.
# Default: 24
IDEMPOTENCY_TTL_HOURS=24
