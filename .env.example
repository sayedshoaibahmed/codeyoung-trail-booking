# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Replace all placeholders before running locally.
DATABASE_URL="postgresql://user:password@localhost:5432/codeyoung?schema=public"

# ── Application ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Browser origins allowed to call this API (in addition to localhost Vite
# and https://*.vercel.app). Comma-separated. No secrets.
# FRONTEND_ORIGIN is also used as the absolute prefix for dummy /class/:bookingId links.
# Example: https://your-app.vercel.app,https://www.example.com
# FRONTEND_ORIGIN=https://codeyoung-trail-booking.vercel.app
# FRONTEND_ORIGINS=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Production API key. Never commit the real value. Read from process.env only.
RESEND_API_KEY=
# Verified sender. Must match a verified Resend domain.
EMAIL_FROM=CodeYoung Trial Booking <bookings@dandeliinn.com>

# ── Admin auth (Render). Never commit real values. ────────────────────────────
# HTTP-only signed session cookie. FRONTEND_ORIGIN should stay set so CORS
# can send credentials from Vercel.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ── Not read by application code ──────────────────────────────────────────────
# Lead time is hardcoded to 2 hours, daily cap to 2 CONFIRMED, and alternates
# to at most 3 slots in the next 12 hours. Idempotency rows are not TTL-pruned.
# BOOKING_LEAD_TIME_HOURS=2
# MENTOR_DAILY_CAP=2
# ALTERNATE_SLOTS_COUNT=3
# IDEMPOTENCY_TTL_HOURS=24
